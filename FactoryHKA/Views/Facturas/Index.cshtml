@model IEnumerable<FactoryHKA.Models.Factura>
@{
    ViewData["Title"] = "Facturas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-receipt"></i> Facturas</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Nueva Factura
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-striped table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Número</th>
                    <th>Fecha</th>
                    <th>Cliente</th>
                    <th class="text-end">Subtotal</th>
                    <th class="text-end">IVA</th>
                    <th class="text-end">Total</th>
                    <th>Estado</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">No hay facturas registradas.</td></tr>
                }
                @foreach (var f in Model)
                {
                    <tr>
                        <td><strong>@f.NumeroFactura</strong></td>
                        <td>@f.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@f.Cliente?.Nombre @f.Cliente?.Apellido</td>
                        <td class="text-end">@f.Subtotal.ToString("C")</td>
                        <td class="text-end">@f.Impuesto.ToString("C")</td>
                        <td class="text-end"><strong>@f.Total.ToString("C")</strong></td>
                        <td>
                            @switch (f.Estado)
                            {
                                case FactoryHKA.Models.EstadoFactura.Pagada:
                                    <span class="badge bg-success">Pagada</span>
                                    break;
                                case FactoryHKA.Models.EstadoFactura.Pendiente:
                                    <span class="badge bg-warning text-dark">Pendiente</span>
                                    break;
                                case FactoryHKA.Models.EstadoFactura.Anulada:
                                    <span class="badge bg-danger">Anulada</span>
                                    break;
                            }
                        </td>
                        <td class="text-center">
                            <a asp-action="Details" asp-route-id="@f.Id" class="btn btn-sm btn-info">
                                <i class="bi bi-eye"></i> Ver
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>